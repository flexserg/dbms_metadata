# Copy to .env. Use URL-safe characters for POSTGRES_PASSWORD, or URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex
APP_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -hex 32
APP_KEY=replace-with-64-hex-characters
# Initialize OpenBao first; see docs/openbao.md. This is a host file mounted as
# a Docker secret, containing a scoped non-root token (never commit the file).
BAO_TOKEN_FILE=./.secrets/openbao-token
